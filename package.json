{
  "name": "kredi",
  "private": true,
  "description": "Le carnet de crédit des commerçants : qui me doit combien, relance WhatsApp et remboursement en Mobile Money.",
  "license": "MIT",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/api",
    "start": "npm run start --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace apps/api",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "seed": "npm run seed --workspace apps/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  }
}
